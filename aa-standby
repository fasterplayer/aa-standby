#!/bin/sh
# aa-standby v4.4 — coupe Android Auto quand la voiture est éteinte, le remet quand elle redémarre.
#
# SIGNAL PRINCIPAL : l'état du gadget USB (/sys/class/udc/.../state).
#   Il suit l'alimentation de l'autoradio, ne dépend ni du Vgate ni du Bluetooth, et il survit à
#   l'arrêt d'aa-proxy-rs (vérifié le 2026-09-17 : le gadget reste attaché ; seul un *démarrage*
#   d'aa-proxy-rs le reconstruit). C'est donc le seul signal utilisable pour le réveil en mode réel.
#
# DÉTECTION DE L'EXTINCTION (trois critères, du plus fiable au plus rapide) :
#   - USB de l'écran détaché depuis USB_OFF s  -> veille. Ne dépend pas de l'OBD, donc marche
#     aussi sans adaptateur OBD et quand le boîtier démarre voiture déjà éteinte.
#   - écran rendu à la voiture (focus natif) + silence OBD >= FOCUS_CONFIRM s -> veille (~25 s).
#     Si les données OBD continuent, c'est juste un passage à la radio : on ne coupe rien.
#   - filet lent : plus aucune donnée OBD depuis OFF_AFTER s -> veille (~90 s).
#
# DÉTECTION DU RÉVEIL :
#   - l'USB de l'écran retombe puis revient -> réveil immédiat (< 2 s), sans Bluetooth ;
#   - filet : le Vgate redevient joignable ET une sonde OBD confirme. Attention, le l2ping seul
#     ne prouve RIEN : mesuré le 2026-09-17, le Vgate reste joignable voiture éteinte (5 faux
#     réveils sur 5). Seule la sonde OBD tranche.
#
# SÉCURITÉS :
#   - au démarrage, Android Auto n'est lancé QUE si l'USB de l'écran est attaché (autoradio sous
#     tension). Sinon on part en VEILLE : inutile de solliciter le téléphone quand la voiture est
#     éteinte. Failsafe : si le gadget USB n'apparaît jamais, on lance Android Auto quand même ;
#   - en état ACTIF, si aa-proxy-rs meurt (plantage), il est relancé ;
#   - si on s'endort sur un critère OBD mais que l'USB ne tombe jamais dans les FALSE_OFF s, c'est
#     qu'on s'est trompé (Vgate mort en roulant) : on rallume et on cesse de croire l'OBD ;
#   - si le script est arrêté (kill), Android Auto est relancé avant de quitter.
#
# v4.3 (2026-09-21) — CORRECTIF DU VA-ET-VIENT VEILLE/ACTIF.
#   Symptôme mesuré (journal du 2026-09-21, boots 92 et 98) : au démarrage voiture allumée mais
#   autoradio pas encore énuméré, l'OBD répond (« voiture RALLUMÉE confirmée par l'OBD ») pendant
#   que l'USB est toujours détaché. Les deux règles se contredisent et le script bascule
#   VEILLE -> ACTIF -> VEILLE toutes les ~36 s. Observé 5 fois en 3 minutes. En mode réel, ça
#   ferait autant de stop/start d'aa-proxy-rs, ce qui peut laisser le gadget USB non lié et tuer
#   Android Auto (voir le piège « /restart ne reconstruit pas le gadget »).
#   Deux garde-fous, indépendants l'un de l'autre :
#     1. La règle USB n'endort plus tant que l'OBD parle. Des données OBD qui arrivent prouvent
#        que le bus de la voiture est vivant, donc qu'elle n'est pas éteinte. Si l'OBD n'a jamais
#        rien donné (seen_data=0 — cas principal : boîtier démarré voiture éteinte, avec ou sans
#        Vgate), le comportement est INCHANGÉ : VEILLE à 41 s comme avant.
#     2. MIN_ACTIF : après un réveil, on ne peut pas se rendormir avant MIN_ACTIF s. Ne s'applique
#        PAS au démarrage (actif_ts=0), donc la veille initiale reste à 41 s. Le réveil, lui,
#        n'est jamais retardé — seul l'endormissement est freiné.
#   Et un troisième filet, sans rapport avec le va-et-vient mais de la même famille :
#     3. VEILLE_MAX (homme mort) : au-delà de VEILLE_MAX s de veille d'affilée, on rallume Android
#        Auto quoi qu'il arrive. Coût si la voiture est vraiment éteinte : ~90 s toutes les 2 h.
#        En échange, AUCUNE panne ne peut plus durer indéfiniment — la v5 du 2026-09-18 avait laissé
#        Android Auto mort 6 h 30 faute d'un filet de ce genre. Ce filet ne fait QUE rallumer, il ne
#        peut donc pas causer la panne qu'il rattrape.
#
# v4.4 (2026-09-25) — DEUX VÉTOS SUR LES RÈGLES OBD.
#   Incident mesuré : voiture garée moteur allumé, la sonde OBD réveille le boîtier, aa-proxy-rs
#   redémarre, mais l'OBD reste muet 90 s (le Vgate sort mal d'une sonde tuée). Le filet lent a
#   conclu « voiture éteinte » ALORS QUE l'USB de l'autoradio était « configured ». FALSE_OFF a
#   rattrapé 4 min plus tard — 4 min d'Android Auto mort, utilisateur au volant.
#     1. Les DEUX règles OBD (filet lent ET détection rapide) exigent udc != configured. Un USB « configured » prouve que la
#        voiture est allumée ; un OBD muet seul ne suffit plus à endormir dans ce cas.
#     2. La détection rapide exige focus_seen_2 : le journal d'aa-proxy-rs n'est PAS tronqué à son
#        redémarrage, donc focus_mode() renvoyait le mode=2 de la session précédente. Le focus
#        n'est cru que s'il a basculé à 2 pendant la période ACTIF courante.
#   Les deux ne font qu'EMPÊCHER un endormissement. Aucun réveil n'est touché.
#
# MODE : contenu de /data/aa-standby.mode -> "observation" (journalise seulement) ou "reel".

MODE=observation

LOG=/data/aa-standby.log
MODE_FILE=/data/aa-standby.mode
OBDLOG=/var/log/aa-proxy-obd.log
RSLOG=/var/log/aa-proxy-rs.log
PROBE_TOML=/tmp/aa-standby-probe.toml
PROBE_LOG=/tmp/aa-standby-probe.log
INIT=/etc/init.d/S93aa-proxy-rs
VGATE=00:00:00:00:00:00   # MAC de votre dongle OBD Bluetooth (voir README)
UDC_STATE=/sys/class/udc/ffb00000.usb/state
# VBUS vu par le PHY USB. Contrairement a UDC_STATE, ne depend pas du gadget USB : il survit
# donc a un arret d'aa-proxy-rs. Dit si la voiture alimente encore le boitier.
EXTCON_STATE=/sys/class/extcon/extcon0/state
# Chemin du gadget USB « accessory ». Variable (et non codé en dur) pour pouvoir être redirigé
# par /etc/aa-standby.conf lors des tests de la machine à états.
GADGET_UDC=/sys/kernel/config/usb_gadget/accessory/UDC

OFF_AFTER=90       # s sans données OBD => voiture éteinte (filet)
FOCUS_CONFIRM=25   # s sans données OBD après « la voiture reprend l'écran » => voiture éteinte
BOOT_GRACE=35      # s de grâce au lancement avant d'appliquer la règle USB (USB attaché a 22-28 s)
FALSE_OFF=240      # s en veille sans que l'USB tombe => on s'est trompé, on rallume (failsafe)
VEILLE_MAX=7200     # s max en veille d'affilee -> on rallume par securite (filet homme mort)
MIN_ACTIF=90        # s minimum en ACTIF apres un reveil avant de pouvoir re-endormir (anti va-et-vient)
USB_OFF=25         # s avec l'USB de l'écran détaché => autoradio hors tension => voiture éteinte
PROBE_SECS=20      # durée max de la sonde OBD de confirmation
COOLDOWN=300       # s sans ping Vgate après un faux réveil
HEARTBEAT=1800
LOOP=2

# --- reglages locaux, sans toucher à ce fichier ---------------------------------------------
# /etc/aa-standby.conf peut redefinir n'importe laquelle des constantes ci-dessus.
[ -r /etc/aa-standby.conf ] && . /etc/aa-standby.conf

# Le nom du contrôleur USB depend de la carte (ffb00000.usb, fe980000.usb...). Si le chemin
# configuré n'existe pas, on prend la seule entrée présente, ce qui marche sur la plupart des cartes.
[ -r "$UDC_STATE" ]    || UDC_STATE=$(ls -d /sys/class/udc/*/state 2>/dev/null | head -1)
[ -r "$EXTCON_STATE" ] || EXTCON_STATE=$(ls -d /sys/class/extcon/*/state 2>/dev/null | head -1)

[ -r "$MODE_FILE" ] && MODE=$(cat "$MODE_FILE")
[ "$MODE" = reel ] || MODE=observation

up() { cut -d. -f1 /proc/uptime; }

log() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') up=$(up)s [$state] $*" >> "$LOG"
    if [ "$(wc -c < "$LOG")" -gt 1048576 ]; then
        mv "$LOG" "$LOG.1"
    fi
}

rs_running() { [ -n "$(pidof aa-proxy-rs)" ]; }

obd_alive() {
    for p in $(pidof aa-proxy-obd); do
        grep -q 'State:.*Z' /proc/$p/status 2>/dev/null || return 0
    done
    return 1
}

start_aa() {
    if [ "$MODE" = reel ]; then
        rs_running || "$INIT" start >/dev/null 2>&1
    fi
}

stop_aa() {
    if [ "$MODE" = reel ]; then
        "$INIT" stop >/dev/null 2>&1
        sleep 2
        for p in $(pidof aa-proxy-obd); do kill "$p" 2>/dev/null; done
    fi
}

count_lines() {
    c=$(grep -c "$2" "$1" 2>/dev/null)
    [ -z "$c" ] && c=0
    echo "$c"
}

data_count() { count_lines "$OBDLOG" 'battery_level_percentage:'; }
# Le hook WASM hu-observe écrit une ligne par changement de focus vidéo.
# 1 = Android Auto est à l'écran, 2 = la voiture a repris l'écran (radio, menus, ou extinction).
focus_mode() {
    m=$(sed 's/\x1b\[[0-9;]*m//g' "$RSLOG" 2>/dev/null | grep -o 'VIDEO_FOCUS mode=[0-9]' | tail -1 | cut -d= -f2)
    [ -z "$m" ] && m=0
    echo "$m"
}

udc_state() { cat "$UDC_STATE" 2>/dev/null || echo inconnu; }

# 1 = la voiture alimente le port USB, 0 = plus de courant (le boitier va tomber).
vbus_state() {
    v=$(grep "^USB=" "$EXTCON_STATE" 2>/dev/null | cut -d= -f2)
    [ -z "$v" ] && v=inconnu
    echo "$v"
}

# Le gadget USB est-il attaché au contrôleur ? Sert à ne pas tuer aa-proxy-rs pendant qu'il le
# construit au démarrage.
gadget_bound() { [ -n "$(cat "$GADGET_UDC" 2>/dev/null)" ]; }

vgate_reachable() { l2ping -c 1 -t 2 "$VGATE" >/dev/null 2>&1; }

# Sonde OBD courte : confirme que la voiture répond vraiment.
probe_obd() {
    rm -f "$PROBE_LOG"
    aa-proxy-obd -c "$PROBE_TOML" >/dev/null 2>&1 &
    pp=$!
    i=0
    while [ "$i" -lt "$PROBE_SECS" ]; do
        grep -q 'battery_level_percentage:' "$PROBE_LOG" 2>/dev/null && break
        sleep 1
        i=$((i + 1))
    done
    kill "$pp" 2>/dev/null
    sleep 1
    kill -9 "$pp" 2>/dev/null
    wait "$pp" 2>/dev/null
    grep -q 'battery_level_percentage:' "$PROBE_LOG" 2>/dev/null
}

sed -e 's#^log_file .*#log_file = "/tmp/aa-standby-probe.log"#' /etc/aa-proxy-obd.toml > "$PROBE_TOML"

state=ACTIF
now=$(up)
prev_data=$(data_count)
prev_udc=$(udc_state)
prev_vbus=$(vbus_state)
last_data=$now
prev_focus=$(focus_mode)
seen_data=0
last_usb_ok=$now
start_ts=$now
usb_dropped=0
veille_ts=$now
# 0 = on n'a pas encore fait de réveil. MIN_ACTIF ne s'applique qu'APRÈS un réveil, jamais au
# démarrage : sinon la veille initiale (le cas principal) serait retardée de 41 s à 131 s.
actif_ts=0
# 1 = on a VU le focus passer à 2 (la voiture reprend l'écran) pendant la période ACTIF courante.
# Le journal d'aa-proxy-rs n'est pas tronqué à son redémarrage, donc focus_mode() peut renvoyer le
# mode=2 de la session PRÉCÉDENTE (mesuré le 2026-09-25). La détection rapide n'a le droit de se
# fier au focus que s'il a changé sous nos yeux. Remis à 0 à chaque réveil.
focus_seen_2=0
cooldown_until=0
last_hb=$now
vg=inconnu

# Filet : quoi qu'il arrive en sortant, Android Auto redémarre.
trap 'log "arrêt du script -> relance Android Auto"; SAVE=$MODE; MODE=reel; start_aa; MODE=$SAVE; exit 0' INT TERM

log "=== démarrage aa-standby v4.4 MODE=$MODE (usb_off=${USB_OFF}s boot_grace=${BOOT_GRACE}s off_after=${OFF_AFTER}s focus_confirm=${FOCUS_CONFIRM}s probe=${PROBE_SECS}s cooldown=${COOLDOWN}s false_off=${FALSE_OFF}s min_actif=${MIN_ACTIF}s veille_max=${VEILLE_MAX}s)"
log "chemins : udc=$UDC_STATE extcon=$EXTCON_STATE init=$INIT"

if [ "$prev_udc" = configured ]; then
    # L'autoradio est déjà là : démarrage normal.
    start_aa
    rs_running && log "aa-proxy-rs actif au démarrage (usb=$prev_udc vbus=$prev_vbus)" || log "aa-proxy-rs NON actif au démarrage (usb=$prev_udc vbus=$prev_vbus)"
else
    # L'autoradio n'est pas alimenté. On ne lance PAS Android Auto : sinon le boîtier sollicite le
    # téléphone pendant toute la fenêtre de grâce, ce qui est exactement ce que l'utilisateur
    # voulait supprimer (choix « option B » du 2026-09-17).
    #
    # PRUDENCE : S93 vient de lancer aa-proxy-rs, qui est en train de (re)construire le gadget USB.
    # Le tuer en plein milieu laisserait un gadget incomplet et l'autoradio ne pourrait plus jamais
    # s'énumérer — Android Auto serait mort jusqu'au prochain reboot. On attend donc que le gadget
    # soit attaché avant de couper. Si l'USB s'attache entre-temps, c'est que la voiture est
    # allumée et on reste ACTIF.
    log "USB de l'écran non attaché au démarrage (vbus=$prev_vbus) — on attend le gadget avant de décider"
    i=0
    while [ "$i" -lt 25 ]; do
        u=$(udc_state)
        [ "$u" = configured ] && break
        gadget_bound && break
        sleep 1
        i=$((i + 1))
    done
    prev_udc=$(udc_state)

    if [ "$prev_udc" = configured ]; then
        last_usb_ok=$(up)
        start_aa
        log "USB attaché pendant l'attente (${i}s) -> voiture allumée -> ACTIF"
    elif gadget_bound; then
        state=VEILLE
        usb_dropped=1
        veille_ts=$(up)
        log "autoradio hors tension -> Android Auto NON lancé, VEILLE (gadget prêt après ${i}s)"
        stop_aa
    else
        # Le gadget n'est jamais apparu : on ne touche à rien. Failsafe — mieux vaut un boîtier
        # qui sollicite le téléphone qu'un boîtier incapable de démarrer Android Auto.
        start_aa
        log "gadget USB absent après ${i}s -> on laisse Android Auto tourner (failsafe)"
    fi
fi

while true; do
    now=$(up)

    # --- données OBD ---
    c=$(data_count)
    [ "$c" -lt "$prev_data" ] && prev_data=0
    if [ "$c" -gt "$prev_data" ]; then
        [ "$seen_data" -eq 0 ] && log "premières données OBD reçues"
        last_data=$now
        seen_data=1
        prev_data=$c
    fi

    # --- qui a l'écran en ce moment ? ---
    f=$(focus_mode)
    if [ "$f" != "$prev_focus" ]; then
        case "$f" in
            1) log "Android Auto a repris l'écran (focus projection)" ;;
            2) focus_seen_2=1; log "la voiture a repris l'écran (focus natif) — extinction, radio ou menus" ;;
        esac
        prev_focus=$f
    fi

    # --- état de la liaison USB avec l'écran ---
    u=$(udc_state)
    if [ "$u" != "$prev_udc" ]; then
        log "USB écran : $prev_udc -> $u"
        prev_udc_before=$prev_udc
        prev_udc=$u
    else
        prev_udc_before=""
    fi

    # --- la voiture alimente-t-elle encore le boitier ? ---
    v=$(vbus_state)
    if [ "$v" != "$prev_vbus" ]; then
        log "alimentation USB (VBUS) : $prev_vbus -> $v"
        prev_vbus=$v
    fi

    # L'USB de l'écran est le signal le plus fiable : il suit l'alimentation de l'autoradio,
    # il ne dépend ni du Vgate ni du Bluetooth, et il survit à l'arrêt d'aa-proxy-rs (vérifié
    # le 2026-09-17 : le gadget reste attaché, seul un *démarrage* d'aa-proxy-rs le reconstruit).
    [ "$u" = configured ] && last_usb_ok=$now

    case "$state" in
        ACTIF)
            # Filet : aa-proxy-rs a planté pendant qu'on roule.
            if ! rs_running; then
                log "aa-proxy-rs absent alors qu'on est ACTIF -> relance"
                SAVE=$MODE; MODE=reel; start_aa; MODE=$SAVE
                last_usb_ok=$(up)   # le redémarrage détache l'USB quelques secondes : on l'ignore
            fi

            silence=$((now - last_data))
            usb_off=$((now - last_usb_ok))
            reason=""

            # GARDE-FOU 2 (v4.3) : après un réveil, on s'interdit de se rendormir avant MIN_ACTIF s.
            # Borne le va-et-vient à un stop/start par MIN_ACTIF au pire, quoi qu'il arrive ensuite
            # dans la logique. Ne freine QUE l'endormissement — un réveil reste immédiat. Et ne
            # s'applique pas au démarrage (actif_ts=0), donc la veille initiale reste à 41 s.
            peut_dormir=1
            if [ "$actif_ts" -ne 0 ] && [ $((now - actif_ts)) -lt "$MIN_ACTIF" ]; then
                peut_dormir=0
            fi
            # Grâce de BOOT_GRACE après le lancement : au boot l'USB met 22 à 28 s à s'attacher, on ne
            # veut pas conclure « voiture éteinte » pendant cette fenêtre.
            if [ "$usb_off" -ge "$USB_OFF" ] && [ $((now - start_ts)) -ge "$BOOT_GRACE" ] \
               && { [ "$seen_data" -eq 0 ] || [ "$silence" -ge "$FOCUS_CONFIRM" ]; }; then
                # Ne dépend pas de seen_data : couvre le cas d'un boîtier démarré voiture éteinte,
                # où aucune donnée OBD n'arrive jamais et où l'ancienne logique restait ACTIF
                # indéfiniment.
                #
                # GARDE-FOU 1 (v4.3) : si l'OBD parle EN CE MOMENT, la voiture n'est pas éteinte —
                # son bus répond. On n'endort donc pas sur le seul critère USB tant que l'OBD n'a
                # pas lui aussi cessé depuis FOCUS_CONFIRM s. C'est le même discriminant que la
                # sonde de la règle 4 du réveil, appliqué dans l'autre sens.
                # Si l'OBD n'a JAMAIS rien donné (seen_data=0), rien ne change : c'est le cas
                # principal (boîtier démarré voiture éteinte, ou pas de Vgate du tout).
                reason="USB de l'écran détaché depuis ${usb_off}s (autoradio hors tension)"
            elif [ "$seen_data" -eq 1 ] && [ "$silence" -gt "$OFF_AFTER" ] && [ "$u" != configured ]; then
                # VÉTO v4.4 : l'USB de l'autoradio « configured » prouve que la voiture est allumée. Un OBD
                # muet seul (Vgate qui lâche, sonde mal sortie) ne suffit plus à endormir dans ce cas.
                reason="pas de données OBD depuis ${silence}s"
            elif [ "$seen_data" -eq 1 ] && [ "$f" = 2 ] && [ "$focus_seen_2" -eq 1 ] && [ "$silence" -ge "$FOCUS_CONFIRM" ] && [ "$u" != configured ]; then
                # VÉTO v4.4 (bis) : même avec un focus frais, un USB « configured » = voiture allumée. Le
                # 2026-09-25 à up=1700s, radio à l'écran + Vgate muet 26 s ont coupé Android Auto 4 min,
                # utilisateur au volant. Avec udc lisible, SEULE la règle USB a le droit d'endormir.
                # VÉTO v4.4 : le focus doit avoir basculé à 2 PENDANT cette période ACTIF (focus_seen_2),
                # sinon c'est la valeur périmée de la session précédente.
                # L'écran appartient à la voiture ET l'OBD s'est tu : extinction très probable.
                # Si Android Auto était à l'écran (focus 1), on préfère attendre le filet lent :
                # un OBD muet vient plus souvent d'un Vgate capricieux que d'une extinction.
                reason="écran à la voiture + aucune donnée OBD depuis ${silence}s (détection rapide)"
            fi

            if [ -n "$reason" ] && [ "$peut_dormir" -eq 0 ]; then
                # Journalisé une seule fois par report, sinon ça inonde le journal toutes les 2 s.
                if [ "$report_logue" != "$actif_ts" ]; then
                    report_logue=$actif_ts
                    log "endormissement reporté ($reason) — réveillé depuis $((now - actif_ts))s, minimum ${MIN_ACTIF}s"
                fi
                reason=""
            fi

            if [ -n "$reason" ]; then
                state=VEILLE
                vg=inconnu
                cooldown_until=0
                usb_dropped=0
                veille_ts=$now
                log "voiture éteinte ($reason) -> VEILLE"
                stop_aa
            fi
            ;;

        VEILLE)
            # L'USB peut mettre jusqu'à ~3 min à se détacher après l'extinction (mesuré), donc on
            # exige de l'avoir vu tomber avant de traiter son retour comme un rallumage. Sans ça,
            # une veille déclenchée par le focus serait annulée dans la seconde.
            [ "$u" != configured ] && usb_dropped=1

            # GARDE-FOU 3 (v4.3) — HOMME MORT. Quelle que soit la raison, on ne reste pas en veille
            # plus de VEILLE_MAX secondes d'affilée : on rallume Android Auto et on repart d'un état
            # propre. Si la voiture est bel et bien éteinte, la règle USB rendormira le boîtier ~41 s
            # plus tard — coût réel : environ 90 s toutes les 2 h, soit 1 % du temps.
            # En échange, AUCUNE panne ne peut plus durer indéfiniment. La v5 (2026-09-18) avait
            # laissé Android Auto mort 6 h 30 faute d'un filet de ce genre ; avec celui-ci elle
            # aurait été rattrapée en 2 h, et les rallumages répétés auraient signalé le problème.
            # Ce filet ne fait QUE rallumer Android Auto — il ne peut donc pas causer la panne
            # qu'il est censé rattraper.
            if [ $((now - veille_ts)) -ge "$VEILLE_MAX" ]; then
                state=ACTIF
                actif_ts=$now; focus_seen_2=0
                last_data=$now
                last_usb_ok=$now
                seen_data=0
                usb_dropped=0
                cooldown_until=0
                log "HOMME MORT : $((VEILLE_MAX / 60)) min de veille d'affilée -> on rallume Android Auto par sécurité"
                SAVE=$MODE; MODE=reel; start_aa; MODE=$SAVE
                continue
            fi

            # 1) Failsafe : on s'est endormi sur un critère OBD alors que l'écran était encore
            # alimenté, et l'USB n'est jamais tombé. Donc la voiture ne s'était pas éteinte —
            # c'est le Vgate qui a lâché en roulant. On rallume plutôt que de laisser Android
            # Auto coupé tout le trajet. seen_data repasse à 0 : on ne refait plus confiance à
            # l'OBD pour endormir tant qu'il n'a pas redonné signe de vie (sinon on boucle).
            if [ "$usb_dropped" -eq 0 ] && [ $((now - veille_ts)) -ge "$FALSE_OFF" ]; then
                state=ACTIF
                last_data=$now
                last_usb_ok=$now
                seen_data=0
                actif_ts=$now; focus_seen_2=0
                log "faux positif : USB de l'écran jamais tombé après ${FALSE_OFF}s -> ACTIF"
                start_aa

            # 2) l'USB de l'écran retombe puis revient : la voiture s'est rallumée. Réveil immédiat,
            #    sans Bluetooth, sans sonde, sans toucher à la batterie.
            elif [ "$usb_dropped" -eq 1 ] && [ "$u" = configured ]; then
                state=ACTIF
                last_data=$now
                last_usb_ok=$now
                actif_ts=$now; focus_seen_2=0
                log "USB de l'écran de nouveau attaché -> voiture rallumée -> ACTIF"
                start_aa

            # 3) des données OBD reviennent (cas où aa-proxy-obd tourne encore)
            elif [ "$last_data" -eq "$now" ]; then
                state=ACTIF
                last_usb_ok=$now
                actif_ts=$now; focus_seen_2=0
                log "données OBD de nouveau présentes -> ACTIF"
                start_aa

            # 4) filet lent : le Vgate répond, on confirme par une sonde OBD.
            #    Le l2ping seul ne prouve RIEN — mesuré le 2026-09-17, le Vgate reste joignable
            #    voiture éteinte (5 faux réveils sur 5). Seule la sonde OBD tranche.
            elif [ "$now" -ge "$cooldown_until" ] && ! obd_alive; then
                if vgate_reachable; then
                    [ "$vg" != reveille ] && log "Vgate joignable -> sonde OBD (${PROBE_SECS}s max)..."
                    vg=reveille
                    if probe_obd; then
                        state=ACTIF
                        last_data=$(up)
                        last_usb_ok=$(up)
                        seen_data=1
                        prev_data=$(data_count)
                        actif_ts=$(up); focus_seen_2=0
                        log "voiture RALLUMÉE (confirmée par l'OBD) -> ACTIF"
                        start_aa
                    else
                        cooldown_until=$(( $(up) + COOLDOWN ))
                        vg=inconnu
                        log "faux réveil (Vgate joignable mais pas de données OBD) -> pause ping ${COOLDOWN}s"
                    fi
                elif [ "$vg" != endormi ]; then
                    vg=endormi
                    log "Vgate injoignable (endormi)"
                fi
            fi
            ;;
    esac

    if [ $((now - last_hb)) -ge "$HEARTBEAT" ]; then
        last_hb=$now
        log "heartbeat: mode=$MODE rs=$(rs_running && echo oui || echo non) obd=$(obd_alive && echo oui || echo non) usb=$u vbus=$v vgate=$vg"
    fi

    sleep "$LOOP"
done
